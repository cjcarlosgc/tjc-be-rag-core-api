generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProjectVersionStatus {
  PENDING
  EXTRACTING
  ANALYZING
  CHUNKING
  EMBEDDING
  PERSISTING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TestTargetType {
  CLASS
  METHOD
  FUNCTION
}

enum TestFramework {
  JEST
  VITEST
}

enum GenerationMode {
  TARGET
  CLASS_ALL
  CLASS_MISSING
  PROJECT_MISSING
  PROJECT_ALL
}

enum TestRunStatus {
  PENDING
  RESOLVING_TARGETS
  PROCESSING_TARGETS
  BATCH_VALIDATING
  FINALIZING
  COMPLETED
  PARTIAL
  FAILED
}

enum TargetRunStatus {
  VALID
  INVALID
  FAILED
  SKIPPED
}

enum FailureType {
  NONE
  COMPILATION
  TEST_ASSERTION
  TEST_RUNTIME
  DEPENDENCY
  CONFIGURATION
  INFRASTRUCTURE
  UNKNOWN
}

enum ArtifactType {
  CREATED
  MODIFIED
}

model Project {
  id               String           @id @default(uuid())
  name             String
  currentVersionId String?          @unique
  currentVersion   ProjectVersion?  @relation("ProjectCurrentVersion", fields: [currentVersionId], references: [id])
  versions         ProjectVersion[] @relation("ProjectVersions")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("projects")
}

model ProjectVersion {
  id               String               @id @default(uuid())
  projectId        String
  project          Project              @relation("ProjectVersions", fields: [projectId], references: [id])
  currentFor       Project?             @relation("ProjectCurrentVersion")
  status           ProjectVersionStatus @default(PENDING)
  originalFileName String?
  sizeBytes        Int?
  snapshotKey      String?
  filesProcessed   Int?
  chunksCount      Int?
  detectedFramework TestFramework?
  targetsTotal     Int?
  targetsWithTest  Int?
  failureReason    String?
  startedAt        DateTime?
  completedAt      DateTime?
  chunks           CodeChunk[]
  testTargets      TestTarget[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([projectId])
  @@map("project_versions")
}

model CodeChunk {
  id               String         @id @default(uuid())
  projectVersionId String
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  filePath         String
  symbolKind       String
  symbolName       String?
  parentSymbolName String?
  startLine        Int
  endLine          Int
  content          String
  importsUsed      String[]       @default([])
  tokenCount       Int?
  partIndex        Int            @default(1)
  partsTotal       Int            @default(1)
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime       @default(now())

  @@index([projectVersionId])
  @@map("code_chunks")
}

model TestTarget {
  id               String         @id @default(uuid())
  projectVersionId String
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  filePath         String
  symbolName       String
  methodName       String?
  targetType       TestTargetType
  startLine        Int
  endLine          Int
  hasTest          Boolean        @default(false)
  testFilePaths    String[]       @default([])
  targetRunResults TargetRunResult[]
  createdAt        DateTime       @default(now())

  @@index([projectVersionId])
  @@map("test_targets")
}

model TestGenerationRun {
  id               String            @id @default(uuid())
  projectId        String
  projectVersionId String
  mode             GenerationMode
  targetId         String?
  status           TestRunStatus     @default(PENDING)
  totalTargets     Int?
  processedTargets Int               @default(0)
  validTargets     Int               @default(0)
  invalidTargets   Int               @default(0)
  failedTargets    Int               @default(0)
  reason           String?
  failureCode      String?
  failureMessage   String?
  startedAt        DateTime?
  completedAt      DateTime?
  targetResults    TargetRunResult[]
  artifacts        Artifact[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@map("test_generation_runs")
}

model TargetRunResult {
  id           String            @id @default(uuid())
  testRunId    String
  testRun      TestGenerationRun @relation(fields: [testRunId], references: [id])
  targetId     String
  target       TestTarget        @relation(fields: [targetId], references: [id])
  filePath     String
  symbolName   String
  methodName   String?
  targetType   TestTargetType
  testFilePath String
  status       TargetRunStatus
  compiled     Boolean?
  executed     Boolean?
  passed       Boolean?
  valid        Boolean?
  failureType  FailureType?
  errorSummary String?
  createdAt    DateTime          @default(now())

  @@index([testRunId])
  @@map("target_run_results")
}

model Artifact {
  id           String            @id @default(uuid())
  testRunId    String
  testRun      TestGenerationRun @relation(fields: [testRunId], references: [id])
  relativePath String
  artifactType ArtifactType
  storageKey   String
  valid        Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([testRunId])
  @@map("artifacts")
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@map("jobs")
}
