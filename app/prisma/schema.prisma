generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProjectVersionStatus {
  PENDING
  EXTRACTING
  ANALYZING
  CHUNKING
  EMBEDDING
  PERSISTING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TestTargetType {
  CLASS
  METHOD
  FUNCTION
}

enum TestFramework {
  JEST
  VITEST
}

model Project {
  id               String           @id @default(uuid())
  name             String
  currentVersionId String?          @unique
  currentVersion   ProjectVersion?  @relation("ProjectCurrentVersion", fields: [currentVersionId], references: [id])
  versions         ProjectVersion[] @relation("ProjectVersions")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("projects")
}

model ProjectVersion {
  id               String               @id @default(uuid())
  projectId        String
  project          Project              @relation("ProjectVersions", fields: [projectId], references: [id])
  currentFor       Project?             @relation("ProjectCurrentVersion")
  status           ProjectVersionStatus @default(PENDING)
  originalFileName String?
  sizeBytes        Int?
  snapshotKey      String?
  filesProcessed   Int?
  chunksCount      Int?
  detectedFramework TestFramework?
  targetsTotal     Int?
  targetsWithTest  Int?
  failureReason    String?
  startedAt        DateTime?
  completedAt      DateTime?
  chunks           CodeChunk[]
  testTargets      TestTarget[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([projectId])
  @@map("project_versions")
}

model CodeChunk {
  id               String         @id @default(uuid())
  projectVersionId String
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  filePath         String
  symbolKind       String
  symbolName       String?
  parentSymbolName String?
  startLine        Int
  endLine          Int
  content          String
  importsUsed      String[]       @default([])
  tokenCount       Int?
  partIndex        Int            @default(1)
  partsTotal       Int            @default(1)
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime       @default(now())

  @@index([projectVersionId])
  @@map("code_chunks")
}

model TestTarget {
  id               String         @id @default(uuid())
  projectVersionId String
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  filePath         String
  symbolName       String
  methodName       String?
  targetType       TestTargetType
  startLine        Int
  endLine          Int
  hasTest          Boolean        @default(false)
  testFilePaths    String[]       @default([])
  createdAt        DateTime       @default(now())

  @@index([projectVersionId])
  @@map("test_targets")
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@map("jobs")
}
