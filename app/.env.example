NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.hhapysqvomhvquylhwvt.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true&schema=public"

# Object storage (Supabase Storage)
SUPABASE_URL="https://hhapysqvomhvquylhwvt.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="repository-zips"

# Async jobs (cola DB-backed)
JOBS_POLL_INTERVAL_MS=1000
JOBS_MAX_ATTEMPTS=3
# Debe ser <= JOBS_STALE_LOCK_MS / 3 (por defecto 600000 / 3 = 200000).
JOBS_HEARTBEAT_INTERVAL_MS=60000

# Indexación
INDEXING_MAX_ZIP_SIZE_BYTES=52428800
INDEXING_POLL_AFTER_MS=1500
INDEXING_MAX_CHUNK_TOKENS=1500

# Retrieval / ContextBuilder
RETRIEVAL_MINIMUM_SCORE=0
RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_CONTEXT_TOKENS=8000
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_STRUCTURAL_WEIGHT=0.3

# Embeddings (OpenAI)
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
LLM_MODEL="gpt-4o-mini"
# Opcional: solo aplica a modelos que soportan razonamiento (none|minimal|low|medium|high|xhigh|max).
# Si se omite, no se envía reasoning_effort en el request.
LLM_REASONING_EFFORT=""

# Experimentos (WI-CORE-023, DEC-EXP-004): modelo y esfuerzo se resuelven una vez por experimento.
# EXPERIMENT_LLM_REASONING_EFFORT vacío = esfuerzo máximo común soportado por el modelo.
EXPERIMENT_LLM_MODEL="gpt-6-luna"
EXPERIMENT_LLM_REASONING_EFFORT=""
# EXPERIMENT_LLM_TEMPERATURE no se puede usar con razonamiento activo (esfuerzo distinto de "none"): el modelo
# responde 400. Si se define con razonamiento activo, crear el experimento falla con TEMPERATURE_UNSUPPORTED_WITH_REASONING.
# Combinaciones modelo/esfuerzo (JSON). Valor verificado contra /v1/responses el 2026-10-09 (WI-CORE-031), con y sin
# herramientas: none, low, medium, high, xhigh y max aceptados; minimal rechazado con 400. `max` solo existe en
# /v1/responses (en /v1/chat/completions no). El código no registra esfuerzos por defecto: sin entrada para un
# modelo, crear un experimento falla con REASONING_EFFORT_UNSUPPORTED. Los niveles válidos son los de la escala
# de providers/reasoning-effort.scale.ts (none, minimal, low, medium, high, xhigh, max); un nivel fuera de ella
# impide arrancar. Otros modelos no tienen verificación: añadir sus entradas solo tras validarlas contra la API.
# El valor real de Render y de app/.env lo fija la persona dueña del despliegue.
LLM_SUPPORTED_COMBINATIONS='[{"model":"gpt-6-luna","efforts":["none","low","medium","high","xhigh","max"],"toolEfforts":["none","low","medium","high","xhigh","max"]}]'
# Latencia medida (WI-CORE-031, tarea de dificultad media sin herramientas): high 7,5 s, xhigh 10,2 s, max 14,1 s.
# OPENAI_TIMEOUT_MS=30000 alcanza para esa llamada. Un turno real del agente con contexto grande o varias llamadas
# podría acercarse al límite: no cambiar el timeout sin medir turnos reales del agente.
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Sandbox (tjc-be-test-execution-sandbox)
# SANDBOX_URL y SANDBOX_SERVICE_TOKEN deben configurarse juntos o ninguno (DEC-AUTH-001).
SANDBOX_URL=""
SANDBOX_SERVICE_TOKEN=""
SANDBOX_DOWNLOAD_TTL_SECONDS=300
SANDBOX_REQUEST_TIMEOUT_MS=10000
SANDBOX_MAX_POLL_ATTEMPTS=120

# GitHub Integration API (tjc-be-github-integration-api)
# Configurar los tres valores juntos. La clave privada, App JWT, installation
# tokens y secreto de webhook pertenecen exclusivamente al componente GH.
GITHUB_INTEGRATION_API_BASE_URL=""
CORE_TO_GITHUB_INTEGRATION_TOKEN=""
GITHUB_INTEGRATION_TO_CORE_TOKEN=""
# Clave exclusiva de Core para firmar pruebas breves de autorización de binding (mínimo 32 caracteres).
GITHUB_BINDING_EVIDENCE_SECRET=""

# Checks nativos por HEAD (013-pr-driven-analysis, HU39).
# CONSOLE_BASE_URL arma el details_url del Check (.../projects/{id}/runs/{id});
# si falta, el Check se publica igual sin ese link. GITHUB_CHECK_NAME es el
# nombre que ve el usuario en la UI de checks del PR.
CONSOLE_BASE_URL=""
GITHUB_CHECK_NAME="RAG Core Analysis"

# Identidad web (012-web-authentication, DEC-WEB-AUTH-001)
# El navegador se autentica con Supabase Auth y envía el access token como
# Authorization: Bearer <token>; el issuer/audience/JWKS se derivan de
# SUPABASE_URL. AUTH_BYPASS_ENABLED solo puede activarse en desarrollo/mock;
# el arranque falla si está activo con NODE_ENV=production.
AUTH_BYPASS_ENABLED="false"
AUTH_BYPASS_USER_ID="local-dev-user"
# HU62 (014): identidad GitHub sintética (id numérico) que aporta el bypass; Core no
# consulta la Admin API de Supabase bajo el bypass. Solo local/mock.
AUTH_BYPASS_GITHUB_USER_ID=900000001

# Agente generalista / costo estimado (008-experimental-comparison)
# Tope de herramientas ejecutadas por el agente (1-100); al alcanzarlo hay una llamada final sin herramientas.
AGENT_MAX_TOOL_CALLS=20
GENERATION_TIMEOUT_MS=120000
EXPERIMENT_REPETITION_CONCURRENCY=3
# Latido de repetición (WI-CORE-025, HU17): cada intento RUNNING renueva su latido con este intervalo (ms, >= 1000).
EXPERIMENT_HEARTBEAT_INTERVAL_MS=15000
# Opcional: umbral (ms) sin latido para dar un intento por vencido. Si se omite, se calcula como
# max(GENERATION_TIMEOUT_MS + (SANDBOX_REQUEST_TIMEOUT_MS * (SANDBOX_MAX_POLL_ATTEMPTS + 2)), 3 * EXPERIMENT_HEARTBEAT_INTERVAL_MS).
# Si se define, nunca se usa menos de 3 * EXPERIMENT_HEARTBEAT_INTERVAL_MS.
# EXPERIMENT_HEARTBEAT_STALE_MS=600000
LLM_INPUT_COST_PER_1K_TOKENS=0.00015
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0006
