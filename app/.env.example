NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.hhapysqvomhvquylhwvt.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true&schema=public"

# Object storage (Supabase Storage)
SUPABASE_URL="https://hhapysqvomhvquylhwvt.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="repository-zips"

# Async jobs (cola DB-backed)
JOBS_POLL_INTERVAL_MS=1000
JOBS_MAX_ATTEMPTS=3

# Indexación
INDEXING_MAX_ZIP_SIZE_BYTES=52428800
INDEXING_POLL_AFTER_MS=1500
INDEXING_MAX_CHUNK_TOKENS=1500

# Retrieval / ContextBuilder
RETRIEVAL_MINIMUM_SCORE=0
RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_CONTEXT_TOKENS=6000
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_STRUCTURAL_WEIGHT=0.3

# Embeddings (OpenAI)
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
LLM_MODEL="gpt-4o-mini"
# Opcional: solo aplica a modelos que soportan razonamiento (none|minimal|low|medium|high|xhigh|max).
# Si se omite, no se envía reasoning_effort en el request.
LLM_REASONING_EFFORT=""
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Sandbox (tjc-be-test-execution-sandbox)
# SANDBOX_URL y SANDBOX_SERVICE_TOKEN deben configurarse juntos o ninguno (DEC-AUTH-001).
SANDBOX_URL=""
SANDBOX_SERVICE_TOKEN=""
SANDBOX_DOWNLOAD_TTL_SECONDS=300
SANDBOX_REQUEST_TIMEOUT_MS=10000
SANDBOX_MAX_POLL_ATTEMPTS=120

# GitHub App ingress (013-pr-driven-analysis, HU31)
# Secreto compartido con la GitHub App para verificar x-hub-signature-256
# sobre el body crudo del webhook. Sin este valor, POST
# /integrations/github/webhooks responde 503 GITHUB_WEBHOOK_UNAVAILABLE.
GITHUB_APP_WEBHOOK_SECRET=""

# GitHub App: autenticación real (013-pr-driven-analysis, HU33-34).
# GITHUB_APP_ID es el App ID visible en la página de settings del App.
# GITHUB_APP_PRIVATE_KEY_BASE64 es el .pem generado ahí ("Generate a private
# key"), codificado en base64 en una sola línea:
#   base64 -i tu-app.pem | tr -d '\n'
# Deben configurarse juntos o ninguno.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY_BASE64=""

# Identidad web (012-web-authentication, DEC-WEB-AUTH-001)
# El navegador se autentica con Supabase Auth y envía el access token como
# Authorization: Bearer <token>; el issuer/audience/JWKS se derivan de
# SUPABASE_URL. AUTH_BYPASS_ENABLED solo puede activarse en desarrollo/mock;
# el arranque falla si está activo con NODE_ENV=production.
AUTH_BYPASS_ENABLED="false"
AUTH_BYPASS_USER_ID="local-dev-user"

# Agente generalista / costo estimado (008-experimental-comparison)
AGENT_MAX_TOOL_CALLS=20
GENERATION_TIMEOUT_MS=120000
EXPERIMENT_REPETITION_CONCURRENCY=3
LLM_INPUT_COST_PER_1K_TOKENS=0.00015
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0006
