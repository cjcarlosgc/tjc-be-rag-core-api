PORT=3000
DATABASE_URL="postgresql://rag_core:rag_core@localhost:5433/rag_core?schema=public"

# Object storage (Supabase Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
OBJECT_STORAGE_BUCKET="rag-core"

# Async jobs (cola DB-backed)
JOBS_POLL_INTERVAL_MS=1000
JOBS_MAX_ATTEMPTS=3

# Indexación
INDEXING_MAX_ZIP_SIZE_BYTES=52428800
INDEXING_POLL_AFTER_MS=1500

# Embeddings (OpenAI)
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
