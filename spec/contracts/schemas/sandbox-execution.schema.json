{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tjc.local/contracts/sandbox-execution.schema.json",
  "title": "Contrato RAG Core ↔ Test Execution Sandbox (INTEROP §7)",
  "description": "Formas de request y response de /executions. El request rechaza campos desconocidos; las responses admiten campos aditivos.",
  "$defs": {
    "SandboxStage": { "type": "string", "enum": ["PREPARING", "INSTALLING_DEPENDENCIES", "COMPILING", "RUNNING_TESTS", "FINALIZING"] },
    "SandboxExecutionStatus": { "type": "string", "enum": ["PENDING", "PREPARING", "INSTALLING_DEPENDENCIES", "COMPILING", "RUNNING_TESTS", "FINALIZING", "COMPLETED", "FAILED", "TIMED_OUT"] },
    "TerminalStatus": { "type": "string", "enum": ["COMPLETED", "FAILED", "TIMED_OUT"] },
    "ExecutionScope": { "type": "string", "enum": ["TARGET", "BATCH"] },
    "ExecutionPhase": { "type": "string", "enum": ["BASELINE", "GENERATED_TESTS"] },
    "ExecutionInputRole": { "type": "string", "enum": ["PROJECT_SNAPSHOT", "GENERATED_ARTIFACT"] },
    "ArtifactType": { "type": "string", "enum": ["CREATED", "MODIFIED"] },
    "EphemeralDownloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "url", "expiresAt", "sha256", "sizeBytes"],
      "properties": {
        "role": { "$ref": "#/$defs/ExecutionInputRole" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "description": "URL HTTPS firmada; capacidad temporal y sensible." },
        "expiresAt": { "$ref": "common.schema.json#/$defs/IsoDateTime" },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "sizeBytes": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" }
      }
    },
    "ExecutionArtifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "relativePath", "artifactType", "download"],
      "properties": {
        "artifactId": { "$ref": "common.schema.json#/$defs/Id" },
        "relativePath": { "$ref": "common.schema.json#/$defs/RelativePath" },
        "artifactType": { "$ref": "#/$defs/ArtifactType" },
        "download": { "$ref": "#/$defs/EphemeralDownloadRef", "description": "role GENERATED_ARTIFACT." }
      }
    },
    "CreateSandboxExecutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "testRunId", "projectVersionId", "snapshot", "artifacts", "scope", "targetIds", "executionProfile", "runnerHint"],
      "properties": {
        "requestId": { "$ref": "common.schema.json#/$defs/Id", "description": "Igual a Idempotency-Key." },
        "testRunId": { "$ref": "common.schema.json#/$defs/Id" },
        "projectVersionId": { "$ref": "common.schema.json#/$defs/Id" },
        "snapshot": { "$ref": "#/$defs/EphemeralDownloadRef", "description": "role PROJECT_SNAPSHOT." },
        "projectRoot": { "$ref": "common.schema.json#/$defs/RelativePath", "description": "INTEROP-2.8; omisión transitoria equivale a '.'." },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/ExecutionArtifactInput" } },
        "scope": { "$ref": "#/$defs/ExecutionScope" },
        "targetIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "executionProfile": { "$ref": "common.schema.json#/$defs/ExecutionProfile" },
        "runnerHint": { "$ref": "common.schema.json#/$defs/TestRunner" },
        "phase": { "$ref": "#/$defs/ExecutionPhase", "description": "Tolerancia transitoria (INTEROP-2.17 §7.2): puede omitirse y equivale a GENERATED_TESTS. Core aún no lo envía (brecha documentada en la feature 013, OC09) y un Sandbox anterior rechazaría el campo." }
      }
    },
    "SandboxExecutionAcceptedResponse": {
      "type": "object",
      "required": ["status", "pollAfterMs", "executionId", "requestId", "projectVersionId"],
      "properties": {
        "status": { "const": "PENDING" },
        "pollAfterMs": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "executionId": { "$ref": "common.schema.json#/$defs/Id" },
        "requestId": { "$ref": "common.schema.json#/$defs/Id" },
        "projectVersionId": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "SandboxExecutionStatusResponse": {
      "type": "object",
      "required": ["executionId", "requestId", "projectVersionId", "status", "stage", "failureCode", "failureMessage", "startedAt", "completedAt", "createdAt", "updatedAt"],
      "properties": {
        "executionId": { "$ref": "common.schema.json#/$defs/Id" },
        "requestId": { "$ref": "common.schema.json#/$defs/Id" },
        "projectVersionId": { "$ref": "common.schema.json#/$defs/Id" },
        "status": { "$ref": "#/$defs/SandboxExecutionStatus" },
        "stage": { "oneOf": [{ "$ref": "#/$defs/SandboxStage" }, { "type": "null" }] },
        "failureCode": { "type": ["string", "null"] },
        "failureMessage": { "type": ["string", "null"] },
        "startedAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/IsoDateTime" }, { "type": "null" }] },
        "completedAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/IsoDateTime" }, { "type": "null" }] },
        "createdAt": { "$ref": "common.schema.json#/$defs/IsoDateTime" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/IsoDateTime" }
      }
    },
    "TestCaseFact": {
      "type": "object",
      "required": ["suitePath", "name", "status", "durationMs", "errorMessage"],
      "properties": {
        "suitePath": { "oneOf": [{ "$ref": "common.schema.json#/$defs/RelativePath" }, { "type": "null" }] },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["PASSED", "FAILED", "SKIPPED", "TODO"] },
        "durationMs": { "oneOf": [{ "$ref": "common.schema.json#/$defs/NonNegativeInteger" }, { "type": "null" }] },
        "errorMessage": { "type": ["string", "null"] },
        "failureKind": { "oneOf": [{ "type": "string", "enum": ["ASSERTION", "ERROR"] }, { "type": "null" }], "description": "Aditivo 2026-10-09; null si el caso no falló. Un Sandbox anterior puede omitirlo." }
      }
    },
    "RunnerFacts": {
      "type": "object",
      "required": ["executionProfile", "runner", "compiled", "executed", "passed", "totalTests", "passedTests", "failedTests", "skippedTests", "testCases", "testCasesTruncated"],
      "properties": {
        "executionProfile": { "$ref": "common.schema.json#/$defs/ExecutionProfile" },
        "runner": { "$ref": "common.schema.json#/$defs/TestRunner" },
        "compiled": { "type": "boolean" },
        "executed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "totalTests": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "passedTests": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "failedTests": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "skippedTests": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "testCases": { "type": "array", "items": { "$ref": "#/$defs/TestCaseFact" } },
        "testCasesTruncated": { "type": "boolean" }
      }
    },
    "StageDuration": {
      "type": "object",
      "required": ["stage", "durationMs"],
      "properties": {
        "stage": { "$ref": "#/$defs/SandboxStage" },
        "durationMs": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" },
        "startedAt": { "$ref": "common.schema.json#/$defs/IsoDateTime", "description": "INTEROP-2.16; ausente en Sandboxes anteriores o en etapas que no lo emiten." },
        "completedAt": { "$ref": "common.schema.json#/$defs/IsoDateTime", "description": "INTEROP-2.16; ausente en Sandboxes anteriores o en etapas que no lo emiten." }
      }
    },
    "SandboxFailureFact": {
      "type": "object",
      "required": ["stage", "category", "code", "message"],
      "properties": {
        "stage": { "$ref": "#/$defs/SandboxStage" },
        "category": { "type": "string", "enum": ["COMPILATION", "TEST_ASSERTION", "TEST_RUNTIME", "DEPENDENCY", "CONFIGURATION", "INFRASTRUCTURE", "UNKNOWN"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "ExecutionEvidenceFact": {
      "type": "object",
      "required": ["kind", "stage", "content", "truncated", "originalBytes"],
      "properties": {
        "kind": { "type": "string", "enum": ["COMPILER_STDOUT", "COMPILER_STDERR", "TEST_STDOUT", "TEST_STDERR", "RUNNER_REPORT"] },
        "stage": { "$ref": "#/$defs/SandboxStage" },
        "content": { "type": "string" },
        "truncated": { "type": "boolean" },
        "originalBytes": { "oneOf": [{ "$ref": "common.schema.json#/$defs/NonNegativeInteger" }, { "type": "null" }] }
      }
    },
    "SandboxExecutionResultResponse": {
      "type": "object",
      "required": ["executionId", "requestId", "testRunId", "projectVersionId", "status", "facts", "failure", "stageDurations", "appliedArtifactIds", "evidence", "startedAt", "completedAt"],
      "properties": {
        "executionId": { "$ref": "common.schema.json#/$defs/Id" },
        "requestId": { "$ref": "common.schema.json#/$defs/Id" },
        "testRunId": { "$ref": "common.schema.json#/$defs/Id" },
        "projectVersionId": { "$ref": "common.schema.json#/$defs/Id" },
        "status": { "$ref": "#/$defs/TerminalStatus" },
        "facts": { "oneOf": [{ "$ref": "#/$defs/RunnerFacts" }, { "type": "null" }] },
        "failure": { "oneOf": [{ "$ref": "#/$defs/SandboxFailureFact" }, { "type": "null" }] },
        "stageDurations": { "type": "array", "items": { "$ref": "#/$defs/StageDuration" } },
        "appliedArtifactIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/ExecutionEvidenceFact" } },
        "startedAt": { "$ref": "common.schema.json#/$defs/IsoDateTime" },
        "completedAt": { "$ref": "common.schema.json#/$defs/IsoDateTime" }
      }
    }
  }
}
